# Proveedor de IA:
# - Producción / Cloud Run (sin API keys): USE_VERTEX_AI=true con IAM (roles/aiplatform.user)
# - Desarrollo local (AI Studio): USE_VERTEX_AI=false y GEMINI_API_KEY=AIzaSy...
USE_VERTEX_AI=false
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini (en Vertex AI global usa gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Backend de datos: duckdb (por defecto en local) o bigquery (para producción / Cloud Run)
DB_BACKEND=duckdb

# Configuración de Google Cloud (BigQuery + Vertex AI)
GCP_PROJECT_ID=my-jenny-514602
GCP_LOCATION=global
BIGQUERY_DATASET=seguros_horizonte
BIGQUERY_LOGS_DATASET=seguros_horizonte_logs

# Ruta local a la clave JSON de la cuenta de servicio (no necesaria en Cloud Run con Workload Identity)
# GOOGLE_APPLICATION_CREDENTIALS=/workspaces/prueba_agente_seguros/creds/bq-sa.json

# Clave secreta para firmar cookies de sesión HttpOnly de la PWA (genera una aleatoria en producción)
APP_SECRET_KEY=cambia-esta-clave-en-produccion
PORT=8080
